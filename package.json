{
  "name": "paperweave",
  "version": "1.1.0",
  "description": "PaperWeave - lightweight cross-platform paper reader with 3D citation graph",
  "main": "main/main.js",
  "author": "PaperWeave",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "node tools/dev-server.js",
    "selftest": "node tools/selftest.js",
    "pack": "node tools/build.js --dir",
    "dist": "node tools/build.js",
    "dist:win": "node tools/build.js --win",
    "dist:mac": "node tools/build.js --mac",
    "dist:mac:x64": "node tools/build.js --mac --x64",
    "dist:mac:arm64": "node tools/build.js --mac --arm64",
    "dist:linux": "node tools/build.js --linux",
    "dist:all": "node tools/build.js --win --mac --linux",
    "apitest": "node tools/api-test.js",
    "exttest": "node tools/ext-api-test.js",
    "mcptest": "node tools/mcp-test.js"
  },
  "build": {
    "appId": "com.paperweave.app",
    "productName": "PaperWeave",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "main/**/*",
      "preload/**/*",
      "renderer/**/*",
      "vendor/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "agents/AGENTS.md",
        "to": "AGENTS.md"
      },
      {
        "from": "mcp/paperweave-mcp.js",
        "to": "paperweave-mcp.js"
      },
      {
        "from": "extension",
        "to": "extension"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "PaperWeave",
      "artifactName": "PaperWeave-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "PaperWeave-${version}-win-${arch}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "PaperWeave-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "artifactName": "PaperWeave-${version}-linux-${arch}.${ext}"
    }
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
